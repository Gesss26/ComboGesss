<!-- Sezione / Vista ✅ Check (puoi mostrarla al click su ✅ Check e chiuderla per tornare a Palinsesto/Home) -->
<section id="checkSection" class="hidden max-w-[1700px] w-full mx-auto px-4 py-6 space-y-5 relative z-10">
  <div class="glass-card rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-extrabold text-white">✅ Check — Storico & Riepilogo per Campionato</h2>
      <p class="text-xs text-slate-400 mt-0.5">
        Verifica tutte le giocate salvate prima del match (Reali & Dixon-Cole, incluse combo) vs risultato reale
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <label class="text-xs text-slate-300 flex items-center gap-1.5 bg-slate-900/90 px-3 py-1.5 rounded-lg border border-slate-700">
        <span>% minima:</span>
        <select id="checkMinPctSelect" onchange="setCheckMinPct(this.value)" class="bg-transparent font-bold text-cyan-300">
          <option value="0">Tutte (0%+)</option>
          <option value="50">50%+</option>
          <option value="60">60%+</option>
          <option value="65">65%+</option>
          <option value="70">70%+</option>
          <option value="75">75%+</option>
          <option value="80">80%+</option>
        </select>
      </label>
      <button type="button" onclick="downloadCheckSnapshotsJson()"
        class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white transition">
        💾 Esporta JSON GitHub
      </button>
      <button type="button" onclick="toggleCheckView(false)"
        class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
        ⬅ Torna al Palinsesto
      </button>
    </div>
  </div>

  <div id="checkSummaryCards" class="grid grid-cols-1 md:grid-cols-3 gap-3"></div>
  <div id="checkLeaguesContainer" class="space-y-3"></div>
</section>

<script>
(function () {
  const CHECK_KEY = "combogesss_check_snapshots_v1";
  const GITHUB_CHECK_PATH = "./data/check_snapshots.json";

  const checkState = {
    isOpen: false,
    minPct: 0,
    snapshots: {} // matchKey -> snapshot object
  };

  function makeMatchKey(leagueCode, m) {
    const d = formatExcelDate(m.date || "");
    const h = String(m.home || "").trim().toLowerCase();
    const a = String(m.away || "").trim().toLowerCase();
    return `${String(leagueCode || "").toUpperCase()}|${d}|${h}|${a}`;
  }

  function parseScore(ftResult) {
    if (!ftResult) return null;
    const m = String(ftResult).trim().match(/(\d+)\s*[-:]\s*(\d+)/);
    if (!m) return null;
    return { hg: parseInt(m[1], 10), ag: parseInt(m[2], 10) };
  }

  // Valutatore completo per singole, doppie chance, Over/Under, Multigol e combo ("A + B")
  function evaluateSingleLeg(label, score) {
    const { hg, ag } = score;
    const total = hg + ag;
    const clean = String(label || "").trim().toUpperCase().replace(/\s+/g, " ");

    // Combo separate da " + " o "&"
    if (clean.includes(" + ") || clean.includes(" & ")) {
      const parts = clean.split(/\s*(?:\+|&)\s*/).filter(Boolean);
      if (!parts.length) return null;
      const results = parts.map(p => evaluateSingleLeg(p, score));
      if (results.some(r => r === null)) return null;
      return results.every(Boolean);
    }

    if (clean === "1") return hg > ag;
    if (clean === "X") return hg === ag;
    if (clean === "2") return ag > hg;
    if (clean === "1X") return hg >= ag;
    if (clean === "X2") return ag >= hg;
    if (clean === "12") return hg !== ag;

    if (clean === "GG" || clean === "GOL") return hg > 0 && ag > 0;
    if (clean === "NG" || clean === "NOGOL" || clean === "NO GOL") return hg === 0 || ag === 0;

    // Over / Under (es. OVER 1,5 / UNDER 2.5)
    const ouMatch = clean.match(/^(OVER|UNDER|OV|UN)\s*([0-9]+(?:[.,][0-9]+)?)$/);
    if (ouMatch) {
      const kind = ouMatch[1];
      const line = parseFloat(ouMatch[2].replace(",", "."));
      if (!Number.isFinite(line)) return null;
      return (kind === "OVER" || kind === "OV") ? total > line : total < line;
    }

    // Multigol (es. MULTIGOL 1-4 oppure MG 2-5)
    const mgMatch = clean.match(/^(?:MULTIGOL|MG)\s*(\d+)\s*[-–]\s*(\d+)$/);
    if (mgMatch) {
      const minG = parseInt(mgMatch[1], 10);
      const maxG = parseInt(mgMatch[2], 10);
      return total >= minG && total <= maxG;
    }

    return null;
  }

  function extractCardPicks(match, leagueCode) {
    const raw = (typeof window.computeMatchTopPicks === "function")
      ? window.computeMatchTopPicks(match, leagueCode, state.resultsRows)
      : { real: [], dixon: [] };

    const normList = (arr, sourceType) => (arr || []).map(item => ({
      source: sourceType, // "real" | "dixon"
      label: String(item.label || "").trim(),
      pct: clampPct(item.pct),
      odd: item.odd ?? item.quota ?? null,
      oddType: item.oddType || (sourceType === "real" ? "reale" : "equa")
    }));

    return {
      real: normList(raw.real, "real"),
      dixon: normList(raw.dixon, "dixon")
    };
  }

  async function loadSnapshotsFromStorageAndGitHub() {
    let localData = null;
    try {
      localData = await cgDB.get(CHECK_KEY);
    } catch (_) {}

    let ghData = null;
    try {
      const resp = await fetch(`${GITHUB_CHECK_PATH}?t=${Date.now()}`, { cache: "no-store" });
      if (resp.ok) {
        ghData = await resp.json();
      }
    } catch (_) {}

    const ghSnaps = (ghData && ghData.snapshots && typeof ghData.snapshots === "object") ? ghData.snapshots : {};
    const locSnaps = (localData && localData.snapshots && typeof localData.snapshots === "object") ? localData.snapshots : {};

    // Unisce record GitHub e record locali dando priorità a quelli congelati o più recenti
    const merged = { ...ghSnaps };
    for (const [k, locItem] of Object.entries(locSnaps)) {
      const existing = merged[k];
      if (!existing) {
        merged[k] = locItem;
      } else if (locItem.frozen && !existing.frozen) {
        merged[k] = locItem;
      } else if ((locItem.updatedAt || "") >= (existing.updatedAt || "")) {
        merged[k] = locItem;
      }
    }

    checkState.snapshots = merged;
    if (typeof localData?.minPctFilter === "number") {
      checkState.minPct = localData.minPctFilter;
    } else if (typeof ghData?.minPctFilter === "number") {
      checkState.minPct = ghData.minPctFilter;
    }

    await persistSnapshotsLocal();
  }

  async function persistSnapshotsLocal() {
    await cgDB.set(CHECK_KEY, {
      version: 1,
      updatedAt: new Date().toISOString(),
      minPctFilter: checkState.minPct,
      snapshots: checkState.snapshots
    });
  }

  // Salva/aggiorna le partite non ancora giocate; congela appena compare il risultato nell'Excel
  async function syncSnapshotsWithRounds() {
    if (!state.roundsByLeague) return;
    let changed = false;
    const nowIso = new Date().toISOString();

    for (const [leagueCode, rounds] of Object.entries(state.roundsByLeague)) {
      const meta = getLeagueMeta(leagueCode);
      for (const r of (rounds || [])) {
        for (const m of (r.matches || [])) {
          const key = makeMatchKey(leagueCode, m);
          const hasResult = Boolean(m.ftResult && parseScore(m.ftResult));
          const existing = checkState.snapshots[key];

          if (hasResult) {
            if (existing && !existing.frozen) {
              existing.frozen = true;
              existing.ftResult = m.ftResult;
              existing.frozenAt = nowIso;
              existing.updatedAt = nowIso;
              changed = true;
            }
            continue;
          }

          // Partita non ancora giocata: aggiorna snapshot finché non è congelato
          if (!existing || !existing.frozen) {
            const picks = extractCardPicks(m, leagueCode);
            checkState.snapshots[key] = {
              key,
              leagueCode,
              leagueName: meta.name,
              country: meta.country,
              date: m.date || "",
              time: m.time || "",
              home: m.home,
              away: m.away,
              ftResult: null,
              frozen: false,
              picks,
              updatedAt: nowIso
            };
            changed = true;
          }
        }
      }
    }

    if (changed) {
      await persistSnapshotsLocal();
    }
  }

  function getMatchDotHtml(leagueCode, m) {
    const score = parseScore(m.ftResult);
    if (!score) return "";
    const snap = checkState.snapshots[makeMatchKey(leagueCode, m)];
    if (!snap) return ""; // Se non c'è snapshot, nessun pallino

    const buildMap = (arr) => {
      const map = new Map();
      for (const p of (arr || [])) {
        const res = evaluateSingleLeg(p.label, score);
        if (typeof res === "boolean") {
          map.set(p.label.trim().toLowerCase(), res);
        }
      }
      return map;
    };

    return {
      realMap: buildMap(snap.picks?.real),
      dixonMap: buildMap(snap.picks?.dixon)
    };
  }

  // Aggiorna la resa delle card nel Palinsesto per aggiungere i pallini 🟢 / 🔴 a destra delle giocate
  function decoratePickBoxesWithDots() {
    const meta = getLeagueMeta(state.selectedLeagueCode);
    const rounds = state.roundsByLeague[state.selectedLeagueCode] || [];
    const roundObj = rounds.find(r => r.roundNumber === state.selectedRound) || rounds[0];
    if (!roundObj) return;

    let matches = [...roundObj.matches];
    if (state.viewMode === "chrono") {
      matches.sort((a, b) => matchSortKey(a) - matchSortKey(b));
    } else {
      matches.sort((a, b) => b.diffForm - a.diffForm);
    }

    const cards = document.querySelectorAll("#matchesList > [role='button']");
    cards.forEach((cardEl, idx) => {
      const m = matches[idx];
      if (!m || !m.ftResult) return;
      const maps = getMatchDotHtml(state.selectedLeagueCode, m);
      if (!maps) return;

      const boxes = cardEl.querySelectorAll(".px-3.py-1\\.5.rounded-xl.bg-slate-900\\/90.border.border-slate-700\\/80.min-w-\\[118px\\]");
      if (boxes.length >= 2) {
        [boxes[0], boxes[1]].forEach((box, boxIdx) => {
          const activeMap = boxIdx === 0 ? maps.realMap : maps.dixonMap;
          const rows = box.querySelectorAll(".space-y-0\\.5 > div");
          rows.forEach(rowEl => {
            if (rowEl.querySelector(".cg-check-dot")) return;
            const firstSpan = rowEl.querySelector("span");
            if (!firstSpan) return;
            const rawLabel = firstSpan.textContent.replace(/:$/, "").trim().toLowerCase();
            if (!activeMap.has(rawLabel)) return;
            const won = activeMap.get(rawLabel);
            const dot = document.createElement("span");
            dot.className = "cg-check-dot ml-1 text-xs leading-none";
            dot.textContent = won ? "🟢" : "🔴";
            dot.title = won ? "Presa" : "Sbagliata";
            rowEl.appendChild(dot);
          });
        });
      }
    });
  }

  function computeStatsByLeague(minPct) {
    const byLeague = {};

    for (const snap of Object.values(checkState.snapshots)) {
      const score = parseScore(snap.ftResult);
      if (!score) continue; // Conteggia solo partite con risultato finale

      const lgCode = snap.leagueCode;
      if (!byLeague[lgCode]) {
        const meta = getLeagueMeta(lgCode);
        byLeague[lgCode] = {
          leagueCode: lgCode,
          leagueName: snap.leagueName || meta.name,
          country: snap.country || meta.country,
          real: { won: 0, lost: 0, estSum: 0, count: 0 },
          dixon: { won: 0, lost: 0, estSum: 0, count: 0 }
        };
      }

      const bucket = byLeague[lgCode];
      for (const src of ["real", "dixon"]) {
        for (const p of (snap.picks?.[src] || [])) {
          const pct = clampPct(p.pct);
          if (pct < minPct) continue;
          const won = evaluateSingleLeg(p.label, score);
          if (typeof won !== "boolean") continue;
          bucket[src].count += 1;
          bucket[src].estSum += pct;
          if (won) bucket[src].won += 1;
          else bucket[src].lost += 1;
        }
      }
    }

    return Object.values(byLeague).sort((a, b) => a.leagueName.localeCompare(b.leagueName, "it"));
  }

  function renderCheckPage() {
    const sel = document.getElementById("checkMinPctSelect");
    if (sel) sel.value = String(checkState.minPct);

    const rows = computeStatsByLeague(checkState.minPct);
    const totalRealWon = rows.reduce((s, r) => s + r.real.won, 0);
    const totalRealCount = rows.reduce((s, r) => s + r.real.count, 0);
    const totalRealEst = rows.reduce((s, r) => s + r.real.estSum, 0);

    const totalDixonWon = rows.reduce((s, r) => s + r.dixon.won, 0);
    const totalDixonCount = rows.reduce((s, r) => s + r.dixon.count, 0);
    const totalDixonEst = rows.reduce((s, r) => s + r.dixon.estSum, 0);

    const totWon = totalRealWon + totalDixonWon;
    const totCount = totalRealCount + totalDixonCount;
    const totEst = totalRealEst + totalDixonEst;

    const fmtRate = (w, c) => c > 0 ? formatPct((w / c) * 100) : "—";
    const fmtAvg = (sum, c) => c > 0 ? formatPct(sum / c) : "—";

    const cardsEl = document.getElementById("checkSummaryCards");
    if (cardsEl) {
      cardsEl.innerHTML = `
        <div class="glass-card rounded-xl p-4">
          <div class="text-xs uppercase tracking-wider text-cyan-300 font-bold">Totale Generale</div>
          <div class="text-2xl font-extrabold text-white mt-1">${totWon}/${totCount} <span class="text-base text-emerald-400">(${fmtRate(totWon, totCount)})</span></div>
          <div class="text-xs text-slate-400 mt-1">Media stimata modelli: <span class="text-cyan-200 font-semibold">${fmtAvg(totEst, totCount)}</span></div>
        </div>
        <div class="glass-card rounded-xl p-4">
          <div class="text-xs uppercase tracking-wider text-cyan-300 font-bold">Giocate Reali</div>
          <div class="text-2xl font-extrabold text-white mt-1">${totalRealWon}/${totalRealCount} <span class="text-base text-emerald-400">(${fmtRate(totalRealWon, totalRealCount)})</span></div>
          <div class="text-xs text-slate-400 mt-1">Media stimata: <span class="text-cyan-200 font-semibold">${fmtAvg(totalRealEst, totalRealCount)}</span></div>
        </div>
        <div class="glass-card rounded-xl p-4">
          <div class="text-xs uppercase tracking-wider text-cyan-300 font-bold">Dixon-Cole</div>
          <div class="text-2xl font-extrabold text-white mt-1">${totalDixonWon}/${totalDixonCount} <span class="text-base text-emerald-400">(${fmtRate(totalDixonWon, totalDixonCount)})</span></div>
          <div class="text-xs text-slate-400 mt-1">Media stimata: <span class="text-cyan-200 font-semibold">${fmtAvg(totalDixonEst, totalDixonCount)}</span></div>
        </div>
      `;
    }

    const listEl = document.getElementById("checkLeaguesContainer");
    if (!listEl) return;

    if (!rows.length) {
      listEl.innerHTML = `<div class="glass-card rounded-xl p-6 text-center text-sm text-slate-400">
        Nessuna partita con risultato finale verificabile al momento. Gli snapshot delle partite non ancora giocate vengono salvati automaticamente e congelati appena carichi i risultati nell'Excel.
      </div>`;
      return;
    }

    listEl.innerHTML = rows.map(r => {
      const rLost = r.real.count - r.real.won;
      const dLost = r.dixon.count - r.dixon.won;
      const tWon = r.real.won + r.dixon.won;
      const tCount = r.real.count + r.dixon.count;
      const tLost = tCount - tWon;
      const tEst = r.real.estSum + r.dixon.estSum;

      return `
        <div class="glass-card rounded-xl p-4 space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="font-bold text-white text-base">${r.leagueName} <span class="text-xs font-normal text-slate-400">(${r.country})</span></div>
            <div class="text-xs font-semibold text-slate-200">
              Totale: 🟢 ${tWon} • 🔴 ${tLost} (${fmtRate(tWon, tCount)}) • Stima media: <span class="text-cyan-300">${fmtAvg(tEst, tCount)}</span>
            </div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs pt-1 border-t border-slate-800/80">
            <div class="bg-slate-900/70 rounded-lg p-2.5 border border-slate-800">
              <span class="font-bold text-cyan-300">Reali:</span>
              🟢 ${r.real.won} / 🔴 ${rLost} (${fmtRate(r.real.won, r.real.count)}) — Stima media: <span class="font-semibold text-white">${fmtAvg(r.real.estSum, r.real.count)}</span>
            </div>
            <div class="bg-slate-900/70 rounded-lg p-2.5 border border-slate-800">
              <span class="font-bold text-cyan-300">Dixon-Cole:</span>
              🟢 ${r.dixon.won} / 🔴 ${dLost} (${fmtRate(r.dixon.won, r.dixon.count)}) — Stima media: <span class="font-semibold text-white">${fmtAvg(r.dixon.estSum, r.dixon.count)}</span>
            </div>
          </div>
        </div>
      `;
    }).join("");
  }

  window.toggleCheckView = function (open) {
    checkState.isOpen = typeof open === "boolean" ? open : !checkState.isOpen;
    const mainEl = document.querySelector("main");
    const checkEl = document.getElementById("checkSection");
    if (mainEl) mainEl.classList.toggle("hidden", checkState.isOpen);
    if (checkEl) checkEl.classList.toggle("hidden", !checkState.isOpen);
    if (checkState.isOpen) renderCheckPage();
  };

  window.setCheckMinPct = async function (val) {
    checkState.minPct = Number(val) || 0;
    await persistSnapshotsLocal();
    renderCheckPage();
  };

  window.downloadCheckSnapshotsJson = function () {
    const payload = {
      version: 1,
      app: "ComboGesss",
      updatedAt: new Date().toISOString(),
      minPctFilter: checkState.minPct,
      snapshots: checkState.snapshots
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "check_snapshots.json";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  };

  // Hook su renderAll così ad ogni aggiornamento dati/apertura vengono salvati gli snapshot e aggiunti i pallini
  const origRenderAll = window.renderAll;
  window.renderAll = async function () {
    if (typeof origRenderAll === "function") origRenderAll();
    await syncSnapshotsWithRounds();
    decoratePickBoxesWithDots();
    if (checkState.isOpen) renderCheckPage();
  };

  window.addEventListener("DOMContentLoaded", async () => {
    await loadSnapshotsFromStorageAndGitHub();
    await syncSnapshotsWithRounds();
    decoratePickBoxesWithDots();
  });
})();
</script>